# ==============================================================================
# 🗄️ SUPABASE
# ==============================================================================

# Project REST URL — found in Supabase Dashboard → Settings → API
SUPABASE_URL=https://<your-ref>.supabase.co

# Service-role key (server-side only — NEVER expose to the client)
# Found in Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_KEY=eyJ...your-service-role-jwt...

# Direct PostgreSQL connection (required for LangGraph PostgresSaver checkpointer)
# Supabase Dashboard → Settings → Database → Connection string → URI
# Note: URL-encode special chars in the password (e.g. @ → %40)
DATABASE_URL=postgresql://postgres:<password>@db.<your-ref>.supabase.co:5432/postgres

# ==============================================================================
# 🔐 AUTH
# ==============================================================================

# HMAC secret for signing JWTs — generate with:  openssl rand -hex 32
JWT_SECRET=<your-jwt-secret-at-least-32-chars>

# ==============================================================================
# 📧 EMAIL — Gmail SMTP (App Passwords)
# ==============================================================================

# Steps to enable:
#   1. Enable 2-Step Verification on your Google Account
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Generate an App Password for "Mail"
#   4. Paste the 16-char code below (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=abcdefghijklmnop

# ==============================================================================
# 🤖 LLM KEYS
# ==============================================================================

# Groq — Llama 3.3 70B for agent orchestration
GROQ_API_KEY=gsk_...

# Google Gemini — text-embedding-004 for RAG vector operations
GEMINI_API_KEY=AIza...
GOOGLE_API_KEY=AIza...

# ==============================================================================
# 🔍 SCOUT (Sales Discovery Agent)
# ==============================================================================

TAVILY_API_KEY=tvly-...
ALERT_EMAIL=sales-manager@yourcompany.com
SCOUT_QUERY=1100V XLPE cable tender RFP India

# ==============================================================================
# ⚙️ RUNTIME
# ==============================================================================

ENV=development
PORT=8000

# Production frontend URL (set this in Render env vars for CORS)
FRONTEND_URL=http://localhost:5173
